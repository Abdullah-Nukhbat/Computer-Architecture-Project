# Copy this file to .env and set the two paths for YOUR machine:
#     cp .env.example .env
# .env is git-ignored, so each group member keeps their own.
# Paths may start with ~ or use $HOME.

# The built simulator binary
SIM=~/simplesim-3.0/sim-outorder

# The BenchMarks_Little folder (must contain Programs/, Input/, Expected_Output/)
BENCH=~/BenchMarks_Little

# Optional: where raw outputs and graphs go (default: results/ and data/ in this repo)
# RES=
# DATA=
